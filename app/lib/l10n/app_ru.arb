    "placeholders": {"n": {"type": "int"}}
  },
  "squarewordResetConfirmTitle": "Сбросить сетку?",
  "@squarewordResetConfirmTitle": {"description": "Title of Module 05's reset confirmation dialog."},
  "squarewordResetConfirmBody": "Все введённые буквы будут стёрты.",
  "@squarewordResetConfirmBody": {"description": "Body of Module 05's reset confirmation dialog."},
  "squarewordWinTitle": "Сетка заполнена!",
  "@squarewordWinTitle": {"description": "Title of Module 05's win dialog."},
  "squarewordWinBody": "Вы заполнили сетку без повторов в строках, столбцах и по диагоналям.",
  "@squarewordWinBody": {"description": "Body of Module 05's win dialog."},
  "squarewordFilledCounter": "Заполнено: {filled} из {total}",
